# Firebase web config (safe to expose in the client — security is enforced by
# Firebase Auth + Firestore security rules, not by hiding these).
#
# Copy this file to `.env.local` for local dev, and set the same vars in Vercel
# (Project → Settings → Environment Variables) for production.
#
# Values come from Firebase Console → Project settings → Your apps → SDK setup.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Server-only secrets for the Gmail-import feature (the /api serverless routes).
# These are NOT prefixed with VITE_ and must never reach the client bundle.
# Set them in Vercel → Settings → Environment Variables (not needed for `vite`
# dev unless you run the functions locally with `vercel dev`).
# ---------------------------------------------------------------------------
# From Google Cloud → APIs & Services → Credentials → your OAuth web client:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Base64 of the Firebase Admin service-account JSON (Project settings →
# Service accounts → Generate new private key), encoded as one line.
FIREBASE_SERVICE_ACCOUNT_B64=
# Optional: comma-separated emails approved for Gmail import. Defaults to the
# owner if unset. Keep in sync with src/lib/gmailFeature.ts (the UI gate).
GMAIL_ALLOWLIST=
